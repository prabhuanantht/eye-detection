{
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  }
}

{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/app.py"
        }
    ],
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "framework": "vite"
}